    <worksheet name='Repeat Customer %'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='-webkit-standard' fontsize='10'>Repeat Customer %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='executive_summary (foodhub)' name='federated.04771kg1n7e6yv150xim61noe0i6' />
          </datasources>
          <datasource-dependencies datasource='federated.04771kg1n7e6yv150xim61noe0i6'>
            <column caption='Customer Orders' datatype='integer' name='[Calculation_0194776960647168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [customer_id] : COUNT([customer_id]) }' />
            </column>
            <column caption='Repeat Customer Flag' datatype='string' name='[Calculation_0194776960782337]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0194776960647168] &gt; 1&#10;THEN &quot;Repeat&quot;&#10;ELSE &quot;New&quot;&#10;END' />
